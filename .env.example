# Environment variables for AgriBotGH
# Set FLASK_DEBUG=true for local debugging only.

FLASK_DEBUG=false
PORT=5000

# Optional server-side Gemini retrieval assistance. Never expose this key in JavaScript.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional server-side natural Twi speech. Keep ABENA_API_KEY off the frontend.
ABENA_TTS_ENABLED=true
ABENA_TTS_API_URL=https://abena.mobobi.com/playground/api/v1/tts/synthesize/
ABENA_TTS_TWI_VOICE=abena_twi_lite
ABENA_TTS_SPEED=1.0
ABENA_API_KEY=
